# ===================================================
# EAS Backend Environment Variables
# ===================================================

# Port to listen on (Render automatically provides PORT in production)
PORT=5000
NODE_ENV=development

# Frontend URL for CORS in production (e.g. https://your-project.vercel.app)
# Comma-separated if multiple domains are needed
FRONTEND_URL=http://localhost:5174

# Database Connection (Supabase / Postgres)
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.afivcwdmxienrwgtxags
DB_PASSWORD=your_database_password
# Optional: Use full connection string instead
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret & Expiry
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxx

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=xxxxxxx
CLOUDINARY_API_KEY=xxxxxxx
CLOUDINARY_API_SECRET=xxxxxxx
